--Поиск товара с максимальной ценой
SELECT products.title, products.price
FROM products
WHERE products.price = (
    SELECT MAX(products.price)
    FROM products
);

--Поиск товара с минимальной ценой
SELECT products.title, products.price
FROM products
WHERE products.price = (
    SELECT MIN(products.price)
    FROM products
);

--Количество товаров в каждой категории 
SELECT categories.name,
       (
           SELECT COUNT(*)
           FROM products
           WHERE products.categories_category_id = categories.category_id
       )
FROM categories;

--Товары дороже средней цены, рассчитаной через и count
SELECT products.title, products.price
FROM products
WHERE products.price > (
    SELECT SUM(products.price) / COUNT(*)
    FROM products
);

--Категории со средней ценой, выше средней цены магазина
SELECT categories.name, ROUND(AVG(products.price), 2)
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
GROUP BY categories.name
HAVING AVG(products.price) > (
    SELECT ROUND(AVG(products.price), 2) 
    FROM products
);

--Товары из провинции Юнань (IN)
SELECT products.title, products.price
FROM products
WHERE products.provinces_province_id IN (
    SELECT provinces.province_id
    FROM provinces
    WHERE provinces.name = 'Юньнань'
);

--Поставщики, у которых пока нет товаров (NOT IN)
SELECT suppliers.name
FROM suppliers
WHERE suppliers.supplier_id NOT IN (
    SELECT products.suppliers_supplier_id
    FROM products
    WHERE products.suppliers_supplier_id IS NOT NULL
);


--Товары дороже хотя бы одного улуна (ANY)
SELECT products.title, products.price
FROM products
WHERE products.price > ANY (
    SELECT products.price
    FROM products
    INNER JOIN categories
    ON products.categories_category_id = categories.category_id
    WHERE categories.name = 'Улун'
);

--Товары дешевле хотя бы одного белого чая (SOME)
SELECT products.title, products.price
FROM products
WHERE products.price < SOME (
    SELECT products.price
    FROM products
    INNER JOIN categories
    ON products.categories_category_id = categories.category_id
    WHERE categories.name = 'Белый чай'
);

--Самые дорогие товары, связанные с поставщиком и отсутствующие на складе (ALL, EXISTS, NOT EXISTS)
SELECT products.title, products.price
FROM products
WHERE products.price >= ALL (
    SELECT products2.price
    FROM products products2
)
AND EXISTS (
    SELECT 1
    FROM suppliers
    WHERE suppliers.supplier_id = products.suppliers_supplier_id
)
AND NOT EXISTS (
    SELECT 1
    FROM warehouse
    WHERE warehouse.products_product_id = products.product_id
);

--Объединение товаров по цене или году сбора (UNION)
SELECT products.title
FROM products
WHERE products.price >= 1500
UNION
SELECT products.title
FROM products
WHERE products.harvest_year >= 2024
ORDER BY title;

--Объединение товаров двух категорий с сохранением повторов (UNION ALL)
SELECT products.title
FROM products
INNER JOIN categories
ON products.categories_category_id = categories.category_id
WHERE categories.name = 'Улун'
UNION ALL
SELECT products.title
FROM products
INNER JOIN categories
ON products.categories_category_id = categories.category_id
WHERE categories.name = 'Белый чай'
ORDER BY title;

--Товары из Юньнани дороже 1000 (INTERSECT)
SELECT products.title
FROM products
WHERE products.provinces_province_id IN (
    SELECT provinces.province_id
    FROM provinces
    WHERE provinces.name = 'Юньнань'
)
INTERSECT
SELECT products.title
FROM products
WHERE products.price > 1000
ORDER BY title;

--Товары категории «Шу Пуэр» стоимостью не ниже 1500 (EXCEPT)
SELECT products.title
FROM products
WHERE products.categories_category_id IN (
    SELECT categories.category_id
    FROM categories
    WHERE categories.name = 'Шу Пуэр'
)
EXCEPT
SELECT products.title
FROM products
WHERE products.price < 1500
ORDER BY title;

--Категории, в которых есть дорогие или недавно собранные товары (UNION)
SELECT categories.name
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
WHERE products.price > 1500
UNION
SELECT categories.name
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
WHERE products.harvest_year >= 2024
ORDER BY name;
