--Выводим всю таблицу
SELECT ALL *
FROM products;

--Вывести три самых дорогих товара
SELECT title, price, harvest_year
FROM products
ORDER BY price DESC 
LIMIT 3;

--Вывести уникальные названия категорий
SELECT DISTINCT categories.name
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id;

--Подсчитать общее колво товаров
SELECT COUNT(*)
FROM products;

--Подсчитать колво заполненных цен
SELECT COUNT(price)
FROM products;

--Подсчитать колво разных поставщиков
SELECT COUNT(DISTINCT suppliers_supplier_id)
FROM products;

--Поиск минимальной цены
SELECT MIN(price)
FROM products;

--Найти максимальную цену
SELECT MAX(price)
FROM products;

--Расчёт общей суммы цен
SELECT SUM(price)
FROM products;

--Расчёт средней цены
SELECT AVG(price)
FROM products;

--Прибавить 300руб к цене каждого товара
SELECT title, price, price + 300
FROM products;

--Рассчитать 10% от цены каждого товара
SELECT title, price, price * 10 / 100
FROM products;

--Использование строковых функций
SELECT
    title,
    UPPER(title),
    LOWER(title),
    LENGTH(title),
    LEFT(title, 10)
FROM products;

--Применение математических функций
SELECT
    title,
    price,
    ROUND(price * 1.05, 2),
    CEILING(price / 100.0),
    FLOOR(price / 100.0),
    ABS(price - 1000)
FROM products;

--Использование функций даты и времени
SELECT
    title,
    CURRENT_DATE,
    CURRENT_TIMESTAMP,
    CURRENT_DATE + INTERVAL '7 days',
    EXTRACT(YEAR FROM CURRENT_DATE)
FROM products;

--Соединение таблиц через FROM и WHERE
SELECT products.title, categories.name
FROM products, categories
WHERE products.categories_category_id = categories.category_id;

--соединение таблиц INNER JOIN
SELECT products.title, categories.name, provinces.name
FROM products
INNER JOIN categories
ON products.categories_category_id = categories.category_id
INNER JOIN provinces
ON products.provinces_province_id = provinces.province_id;

--Соединение таблиц FULL JOIN
SELECT
    categories.category_id,
    categories.name,
    products.product_id,
    products.title
FROM categories
FULL JOIN products
ON categories.category_id = products.categories_category_id;

--Найти категории, у которых нет товаров
SELECT categories.name, products.product_id
FROM categories
LEFT JOIN products
ON categories.category_id = products.categories_category_id
WHERE products.product_id IS NULL;

--Соединение таблиц RIGHT JOIN
SELECT categories.name, products.product_id, products.title
FROM products
RIGHT JOIN categories
ON products.categories_category_id = categories.category_id;

--Сравнение с помощью знаков больше и меньше
SELECT title, price
FROM products
WHERE price > 1000
AND price < 2000
AND provinces_province_id IS NOT NULL
ORDER BY price;

--Использование операторов AND и OR
SELECT title, price, categories_category_id
FROM products
WHERE (categories_category_id = 1 AND price != 0)
OR (categories_category_id = 2 AND price = 1750);

--Использование BETWEEN
SELECT title, price
FROM products
WHERE price BETWEEN 900 AND 1800;

--Использование NOT BETWEEN, IN, NOT IN
SELECT title, price, categories_category_id, suppliers_supplier_id
FROM products
WHERE price NOT BETWEEN 900 AND 1600
OR (categories_category_id IN (1, 2)
AND suppliers_supplier_id NOT IN (3, 4));

--Поиск по шаблону LIKE и сортировка
SELECT title, price
FROM products
WHERE title LIKE '%Пуэр%'
ORDER BY price DESC;
