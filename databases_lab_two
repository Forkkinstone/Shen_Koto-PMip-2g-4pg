-------------------------------------------------------------ЛАБОРАТОРНАЯ РАБОТА №3--------------------------------------------------------------
-----------------------------------------------Проверка INSERT, UPDATE, DELETE и внешних ключей--------------------------------------------------


-----ЭТАП 4. СОЗДАНИЕ ДВУХ ТЕСТОВЫХ ТАБЛИЦ-----
--Используем отдельные таблицы, чтобы не менять основные. DROP TABLE позволяет повторно подготовить тестовую часть.

DROP TABLE IF EXISTS lab3_products;
DROP TABLE IF EXISTS lab3_categories;

-- Родительская таблица: категории
CREATE TABLE lab3_categories (
    category_id INT PRIMARY KEY,
    category_name VARCHAR(100) NOT NULL
);

-- Дочерняя таблица: товары
CREATE TABLE lab3_products (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(100) NOT NULL,
    category_id INT DEFAULT 1,

    -- Создаём внешний ключ с начальной настройкой NO ACTION
    CONSTRAINT fk_lab3_products_category
        FOREIGN KEY (category_id)
        REFERENCES lab3_categories(category_id)
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
);



