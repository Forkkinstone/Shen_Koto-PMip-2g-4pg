-----ЭТАП 1. СОЗДАНИЕ ОСНОВНЫХ ТАБЛИЦ-----

-- Таблица категорий чая
CREATE TABLE categories (
    category_id SERIAL PRIMARY KEY,
    name VARCHAR(45) NOT NULL
);

-- Таблица регионов производства
CREATE TABLE provinces (
    province_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    description TEXT
);

-- Таблица поставщиков
CREATE TABLE suppliers (
    supplier_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    contact_info VARCHAR(150)
);

-- Таблица товаров
CREATE TABLE products (
    product_id SERIAL PRIMARY KEY,
    title VARCHAR(100) NOT NULL,
    price DECIMAL(10,2) NOT NULL,
    harvest_year INT,
    categories_category_id INT,
    provinces_province_id INT,
    suppliers_supplier_id INT,
    FOREIGN KEY (categories_category_id)
        REFERENCES categories(category_id),
    FOREIGN KEY (provinces_province_id)
        REFERENCES provinces(province_id),
    FOREIGN KEY (suppliers_supplier_id)
        REFERENCES suppliers(supplier_id)
);

-- Таблица покупателей
CREATE TABLE users (
    user_id SERIAL PRIMARY KEY,
    username VARCHAR(100) NOT NULL,
    email VARCHAR(100),
    phone VARCHAR(20)
);

-- Таблица способов доставки
CREATE TABLE deliveries (
    delivery_id SERIAL PRIMARY KEY,
    method_name VARCHAR(100) NOT NULL,
    cost DECIMAL(10,2) NOT NULL
);

-- Таблица заказов
CREATE TABLE orders (
    order_id SERIAL PRIMARY KEY,
    order_date VARCHAR(45) NOT NULL,
    status VARCHAR(50) NOT NULL,
    users_user_id INT,
    deliveries_delivery_id INT,
    FOREIGN KEY (users_user_id)
        REFERENCES users(user_id),
    FOREIGN KEY (deliveries_delivery_id)
        REFERENCES deliveries(delivery_id)
);

-- Таблица состава заказов
CREATE TABLE order_items (
    order_item_id SERIAL PRIMARY KEY,
    quantity INT NOT NULL,
    orders_order_id INT,
    products_product_id INT,
    FOREIGN KEY (orders_order_id)
        REFERENCES orders(order_id),
    FOREIGN KEY (products_product_id)
        REFERENCES products(product_id)
);

-- Таблица складских остатков
CREATE TABLE warehouse (
    stock_id SERIAL PRIMARY KEY,
    quantity_gram INT NOT NULL,
    shelf_location VARCHAR(45),
    products_product_id INT,
    FOREIGN KEY (products_product_id)
        REFERENCES products(product_id)
);


