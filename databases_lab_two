-----ЭТАП 9. NO ACTION-----

--Проверяем запрет изменения и удаления родительской записи, на которую ссылается товар.

--9.1. Пробуем изменить ID категории 2 на 20. Ожидаем: ОШИБКА, так как на категорию ссылается товар.

UPDATE lab3_categories
SET category_id = 20
WHERE category_id = 2;



--9.2. Пробуем удалить категорию 2. Ожидаем: ОШИБКА, так как на категорию ссылается товар.

DELETE FROM lab3_categories
WHERE category_id = 2;



-----ЭТАП 10. CASCADE-----

--Удаляем старое ограничение и создаём новое. Теперь изменение и удаление родителя передаётся дочерним записям автоматически.

ALTER TABLE lab3_products
DROP CONSTRAINT fk_lab3_products_category;

ALTER TABLE lab3_products
ADD CONSTRAINT fk_lab3_products_category
FOREIGN KEY (category_id)
REFERENCES lab3_categories(category_id)
ON UPDATE CASCADE
ON DELETE CASCADE;


--10.1. Проверяем ON UPDATE CASCADE. Ожидаем: ID категории в таблице товаров тоже станет 20.

UPDATE lab3_categories
SET category_id = 20
WHERE category_id = 2;

SELECT * FROM lab3_products;


--Возвращаем ID категории обратно. CASCADE автоматически вернёт ID товара к значению 2. */

UPDATE lab3_categories
SET category_id = 2
WHERE category_id = 20;

SELECT * FROM lab3_products;


--10.2. Проверяем ON DELETE CASCADE. Ожидаем: удаление категории автоматически удалит товар.

DELETE FROM lab3_categories
WHERE category_id = 2;

SELECT * FROM lab3_products;


--Восстанавливаем удалённую категорию и товар для следующего эксперимента.

INSERT INTO lab3_categories
(category_id, category_name)
VALUES
(2, 'Шу Пуэр');

INSERT INTO lab3_products
(product_id, product_name, category_id)
VALUES
(101, 'Мэнхайский Шу Пуэр', 2);



-----ЭТАП 11. SET NULL-----

--При изменении или удалении родительской записи внешний ключ товара будет принимать значение NULL.

ALTER TABLE lab3_products
DROP CONSTRAINT fk_lab3_products_category;

ALTER TABLE lab3_products
ADD CONSTRAINT fk_lab3_products_category
FOREIGN KEY (category_id)
REFERENCES lab3_categories(category_id)
ON UPDATE SET NULL
ON DELETE SET NULL;


--11.1. Проверяем ON UPDATE SET NULL. Ожидаем: category_id товара станет NULL.

UPDATE lab3_categories
SET category_id = 20
WHERE category_id = 2;

SELECT * FROM lab3_products;


--Восстанавливаем исходные значения для проверки DELETE. Сначала возвращаем ID категории, затем связь товара с ней.

UPDATE lab3_categories
SET category_id = 2
WHERE category_id = 20;

UPDATE lab3_products
SET category_id = 2
WHERE product_id = 101;


--11.2. Проверяем ON DELETE SET NULL. Ожидаем: категория удалится, товар останется, но его category_id станет NULL.

DELETE FROM lab3_categories
WHERE category_id = 2;

SELECT * FROM lab3_products;


--Восстанавливаем связь для следующего эксперимента.

INSERT INTO lab3_categories
(category_id, category_name)
VALUES
(2, 'Шу Пуэр');

UPDATE lab3_products
SET category_id = 2
WHERE product_id = 101;



-----ЭТАП 12. SET DEFAULT-----

--При изменении или удалении родительской записи внешний ключ товара примет значение по умолчанию: 1. 
--Категория с ID = 1 существует, поэтому ссылка корректна.

ALTER TABLE lab3_products
DROP CONSTRAINT fk_lab3_products_category;

ALTER TABLE lab3_products
ADD CONSTRAINT fk_lab3_products_category
FOREIGN KEY (category_id)
REFERENCES lab3_categories(category_id)
ON UPDATE SET DEFAULT
ON DELETE SET DEFAULT;


--12.1. Проверяем ON UPDATE SET DEFAULT. Ожидаем: category_id товара станет равен 1.

UPDATE lab3_categories
SET category_id = 20
WHERE category_id = 2;

SELECT * FROM lab3_products;


--Восстанавливаем исходное состояние для проверки DELETE.

UPDATE lab3_categories
SET category_id = 2
WHERE category_id = 20;

UPDATE lab3_products
SET category_id = 2
WHERE product_id = 101;



--12.2. Проверяем ON DELETE SET DEFAULT. Ожидаем: категория удалится, товар останется, его category_id станет равен 1.

DELETE FROM lab3_categories
WHERE category_id = 2;

SELECT * FROM lab3_products;


