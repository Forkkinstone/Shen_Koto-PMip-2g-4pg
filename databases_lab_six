--Подсчитать количество товаров в каждой категории
SELECT categories.name, COUNT(*)
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
GROUP BY categories.name;

--Найти среднюю цену товаров в каждой категории
SELECT categories.name, AVG(products.price)
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
GROUP BY categories.name;

--Найти минимальную и максимальную цену товаров по регионам
SELECT provinces.name, MIN(products.price), MAX(products.price)
FROM provinces
INNER JOIN products
ON products.provinces_province_id = provinces.province_id
GROUP BY provinces.name;

--Подсчитать количество товаров у каждого поставщика
SELECT suppliers.name, COUNT(*)
FROM suppliers
INNER JOIN products
ON products.suppliers_supplier_id = suppliers.supplier_id
GROUP BY suppliers.name;

--Найти суммарную стоимость товаров каждой категории
SELECT categories.name, SUM(products.price)
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
GROUP BY categories.name;

--Найти среднюю цену товаров по категориям, собранных с 2022 года
SELECT categories.name, AVG(products.price)
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
WHERE products.harvest_year >= 2022
GROUP BY categories.name;

--Подсчитать количество и сумму цен товаров дороже 1000 рублей в каждой категории
SELECT categories.name, COUNT(*), SUM(products.price)
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
WHERE products.price > 1000
GROUP BY categories.name;

--Подсчитать количество товаров и среднюю цену для каждого года сбора, отсортировав по году
SELECT products.harvest_year, COUNT(*), AVG(products.price)
FROM products
WHERE products.harvest_year IS NOT NULL
GROUP BY products.harvest_year
ORDER BY products.harvest_year DESC;

--Найти категории, в которых не менее двух товаров
SELECT categories.name, COUNT(*)
FROM categories
INNER JOIN products
ON products.categories_category_id = categories.category_id
GROUP BY categories.name
HAVING COUNT(*) >= 2;

--Найти поставщиков со средней ценой товаров выше 1000 рублей среди товаров, собранных с 2022 года
SELECT suppliers.name, AVG(products.price)
FROM suppliers
INNER JOIN products
ON products.suppliers_supplier_id = suppliers.supplier_id
WHERE products.harvest_year >= 2022
GROUP BY suppliers.name
HAVING AVG(products.price) > 1000
ORDER BY AVG(products.price) DESC;
